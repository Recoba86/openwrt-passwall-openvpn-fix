# Dummy fixture for auth-user-pass plus unencrypted inline key.
client
dev tun
proto tcp-client
persist-key
persist-tun
remote 198.51.100.10 1194 tcp
remote-cert-tls server
verb 3
auth-user-pass
auth SHA1
cipher AES-256-CBC

<ca>
-----BEGIN CERTIFICATE-----
AUTH-ONLY-CA-PLACEHOLDER
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
AUTH-ONLY-CERT-PLACEHOLDER
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN RSA PRIVATE KEY-----
AUTH-ONLY-KEY-PLACEHOLDER
-----END RSA PRIVATE KEY-----
</key>
