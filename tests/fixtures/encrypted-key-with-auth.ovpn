# Dummy fixture for auth-user-pass plus encrypted inline key.
client
dev tun
proto tcp-client
persist-key
persist-tun
remote 203.0.113.20 443 tcp
remote-cert-tls server
verb 4
auth-user-pass
auth SHA1
cipher AES-128-CBC

<ca>
-----BEGIN CERTIFICATE-----
ENCRYPTED-KEY-CA-PLACEHOLDER
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
ENCRYPTED-KEY-CERT-PLACEHOLDER
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN ENCRYPTED PRIVATE KEY-----
ENCRYPTED-KEY-PLACEHOLDER
-----END ENCRYPTED PRIVATE KEY-----
</key>
