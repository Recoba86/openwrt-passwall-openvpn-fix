# Dummy fixture for certificate-only auth with modern data-ciphers already present.
client
dev tun
proto udp
persist-key
persist-tun
remote 192.0.2.30 1194 udp
remote-cert-tls server
verb 3
auth SHA256
cipher AES-256-CBC
data-ciphers AES-256-CBC:AES-128-CBC
data-ciphers-fallback AES-256-CBC

<ca>
-----BEGIN CERTIFICATE-----
CERT-ONLY-CA-PLACEHOLDER
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
CERT-ONLY-CERT-PLACEHOLDER
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN RSA PRIVATE KEY-----
CERT-ONLY-KEY-PLACEHOLDER
-----END RSA PRIVATE KEY-----
</key>
